{
  "name": "audiobooks-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": "Alexey Butkeev, Egor Filin",
  "scripts": {
    "dev": "vite",
    "prestart": "npm run prebuild",
    "start": "vite --open",
    "prebuild": "npm run compile-openapi",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format:check": "prettier -c .",
    "format": "prettier -w .",
    "compile-openapi": "rtk-query-codegen-openapi src/api/openapi-config.ts",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal public/logo.svg",
    "i18next:extract": "i18next-cli extract",
    "preview": "npm run build && vite preview --open"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.10",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@passwordless-id/webauthn": "^2.3.5",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.15.0",
    "buffer": "^6.0.3",
    "copy-to-clipboard": "^3.3.3",
    "cyrillic-to-translit-js": "^3.2.1",
    "generate-password-browser": "^1.1.0",
    "i18next": "^26.0.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.2",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.0",
    "socket.io-client": "^4.8.3",
    "throttle-debounce": "^5.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@types/debounce": "^1.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/throttle-debounce": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "esbuild-runner": "^2.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "i18next-cli": "^1.51.7",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
